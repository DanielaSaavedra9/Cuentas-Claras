rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /Usuarios/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['fechaRegistro', 'consentimientoAceptado', 'fechaConsentimiento']);
      // Menú de usuario — "Darse de baja" (.claude/dropdown-cerrar-sesion.md):
      // sin esto, eliminarCuentaCompleta() no podía borrar el propio
      // documento del usuario (no había ninguna regla `allow delete` acá).
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /movimientos/{movId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /escenariosGuardados/{escenarioId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // RF07 Bloque 0: cualquier usuario autenticado puede leer la tasa de
    // referencia; la escritura la hace únicamente scripts/actualizar-tasa-consumo.mjs
    // vía Firebase Admin SDK, que no pasa por estas reglas (son solo para
    // el SDK de cliente) — allow write: if false lo deja explícito.
    match /tasasReferencia/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
